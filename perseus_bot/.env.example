# =============================================================================
# Perseus — Environment Variables
# Camelot Property Management Services Corp.
#
#   cp perseus_bot/.env.example .env
#
# NEVER commit .env to version control.
# =============================================================================


# =============================================================================
# SUPABASE (required — stores variance reports, reads portfolio comparables)
# =============================================================================

# Supabase project URL — Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only — never expose to a browser).
# perseus_variance_reports has RLS enabled with a service-role-only policy,
# so reads and writes fail without this key.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here


# =============================================================================
# OPENAI (optional — recommendation prose only)
# =============================================================================

# Used solely to rephrase recommendation text that has already been decided by
# the deterministic engine. Every dollar figure in the report is computed in
# Python. With this unset, Perseus falls back to the built-in mechanism text and
# the numbers are unchanged.
OPENAI_API_KEY=


# =============================================================================
# OPTIONAL — runtime overrides
# =============================================================================

# Where generated PDFs are written (default: output/perseus)
# PERSEUS_OUTPUT_DIR=output/perseus

# Python log level (default: INFO from config.yaml)
# LOG_LEVEL=INFO

# Log file path (default: logs/perseus_bot.log)
# LOG_FILE=logs/perseus_bot.log
