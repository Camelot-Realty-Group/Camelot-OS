# concierge_bot/.env.example
# Copy to .env and fill in your values. Never commit .env to source control.

# API server
CONCIERGE_BOT_HOST=0.0.0.0
CONCIERGE_BOT_PORT=8004

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/concierge_bot.log

# Optional — only needed if you move the library/masters off local disk
# and onto Supabase Storage or Google Drive in a future revision.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
