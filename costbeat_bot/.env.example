# costbeat_bot/.env.example
# Copy to .env and fill in your values. Never commit .env to source control.

# API server
COSTBEAT_BOT_HOST=0.0.0.0
COSTBEAT_BOT_PORT=8005

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/costbeat_bot.log

# Supabase — required. Stores analyses and holds the portfolio comparables the
# whole analysis is built on. Use the service-role key, not the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# OpenAI — optional. Used only to tighten the "How We Get There" prose after
# every dollar figure is already fixed. Without it the deterministic
# category mechanism text is used instead.
OPENAI_API_KEY=sk-your_openai_key_here

# Where the branded PDFs are written (defaults to config.yaml reports_output_dir)
COSTBEAT_OUTPUT_DIR=output/costbeat

# Spire (camelot.spiremds.com) — optional. Lets staff pull a building's
# budget directly from Spire instead of uploading a file. Manual file upload
# keeps working with or without these set; without them the "Pull from
# Spire" option is simply disabled in the UI. See utils/spire_client.py.
SPIRE_API_KEY=your_spire_api_key_here
SPIRE_CLIENT_SECRET=your_spire_client_secret_here
# Optional — defaults to https://camelot.spiremds.com/api if unset.
SPIRE_BASE_URL=https://camelot.spiremds.com/api
